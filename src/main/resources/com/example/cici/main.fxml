<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<VBox prefHeight="1080" prefWidth="1920" alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml" stylesheets="@../../../css/style.css"
      fx:controller="com.example.cici.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
<!--        <Button fx:id="btnChoose" mnemonicParsing="false" text="Choose" />-->
        <Button fx:id="btnCompare" mnemonicParsing="false" text="Compare" />
        <Button fx:id="btnReset" mnemonicParsing="false" text="Reset"  onAction="#Reset"/>
        <Button fx:id="btnClose" mnemonicParsing="false" text="Reset" />
    </HBox>

<!--    <Label fx:id="welcomeText"/>-->
<!--    <Button text="Hello!" onAction="#onHelloButtonClick"/>-->
    <VBox spacing="5.0">
        <Label styleClass="label-title">Table Root</Label>
        <TableView fx:id="tblRoot" prefHeight="400" prefWidth="1920"></TableView>
    </VBox>

    <VBox spacing="5.0">
        <Label styleClass="label-title">Table Compare</Label>
        <TableView fx:id="tblCompare" prefHeight="400" prefWidth="1920"></TableView>
    </VBox>

</VBox>
